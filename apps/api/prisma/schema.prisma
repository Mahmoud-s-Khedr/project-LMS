  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?          @db.Timestamptz(3)
  endedAt              DateTime?          @db.Timestamptz(3)
  entitlementSnapshot  Json
  lastSyncedAt         DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  workspace            Workspace          @relation("Subscription_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  userId               String             @db.Uuid
  user                 User               @relation("Subscription_user", fields: [userId], references: [id], onDelete: Restrict)
  productId            String             @db.Uuid
  product              Product            @relation("Subscription_product", fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  priceId              String             @db.Uuid
  price                Price              @relation("Subscription_price", fields: [workspaceId, priceId], references: [workspaceId, id], onDelete: Restrict)
