  gradedBy       User?             @relation("GradeEvent_gradedBy", fields: [gradedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, attemptId, answerId])
  @@index([gradedById])
  @@index([workspaceId, attemptId, createdAt])
}

model Product {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @db.Uuid
  type               ProductType
  status             ProductStatus   @default(DRAFT)
  slug               String          @db.VarChar(140)
  name               String          @db.VarChar(240)
  description        Json            @default("{}")
  accessDurationDays Int?
  stripeProductId    String?         @unique @db.VarChar(255)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?       @db.Timestamptz(3)
  workspace          Workspace       @relation("Product_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  productCourses     ProductCourse[] @relation("ProductCourse_product")
  prices             Price[]         @relation("Price_product")
  couponProducts     CouponProduct[] @relation("CouponProduct_product")
  orderItems         OrderItem[]     @relation("OrderItem_product")
  subscriptions      Subscription[]  @relation("Subscription_product")

  @@unique([workspaceId, id])
  @@unique([workspaceId, slug])
}

/// COURSE products contain exactly one course; BUNDLE/PLAN contain one or more. Fulfillment snapshots membership.
model ProductCourse {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation("ProductCourse_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  productId   String    @db.Uuid
  product     Product   @relation("ProductCourse_product", fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  courseId    String    @db.Uuid
  course      Course    @relation("ProductCourse_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([productId, courseId])
  @@index([workspaceId, productId])
  @@index([workspaceId, courseId])
}

/// Money is integer minor units. Price amount/currency/interval immutable after first use.
model Price {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @db.Uuid
  currency      String           @db.Char(3)
  amount        Int
  interval      BillingInterval?
  intervalCount Int              @default(1)
  trialDays     Int              @default(0)
  isActive      Boolean          @default(true)
  stripePriceId String?          @unique @db.VarChar(255)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  workspace     Workspace        @relation("Price_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  productId     String           @db.Uuid
  product       Product          @relation("Price_product", fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
  orderItems    OrderItem[]      @relation("OrderItem_price")
  subscriptions Subscription[]   @relation("Subscription_price")

  @@unique([workspaceId, id])
  @@index([workspaceId, productId, isActive])
}

model Coupon {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @db.Uuid
  code               String             @db.VarChar(80)
  kind               CouponKind
  percentOff         Decimal?           @db.Decimal(5, 2)
  amountOff          Int?
  currency           String?            @db.Char(3)
  validFrom          DateTime           @db.Timestamptz(3)
  validUntil         DateTime?          @db.Timestamptz(3)
  maxRedemptions     Int?
  maxPerUser         Int                @default(1)
  minimumOrderAmount Int                @default(0)
  isActive           Boolean            @default(true)
  stripeCouponId     String?            @unique @db.VarChar(255)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?          @db.Timestamptz(3)
  workspace          Workspace          @relation("Coupon_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  couponProducts     CouponProduct[]    @relation("CouponProduct_coupon")
  orders             Order[]            @relation("Order_coupon")
  couponRedemptions  CouponRedemption[] @relation("CouponRedemption_coupon")

  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
}

model CouponProduct {
  id          String    @id @default(uuid()) @db.Uuid
