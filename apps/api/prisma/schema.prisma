  gradeEvents           GradeEvent[]       @relation("GradeEvent_answer")

  @@unique([workspaceId, id])
  @@unique([workspaceId, attemptId, id])
  @@unique([attemptQuestionId])
  @@unique([workspaceId, attemptId, attemptQuestionId])
  @@index([workspaceId, attemptId, attemptQuestionId])
}

model AnswerAttachment {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  workspace   Workspace     @relation("AnswerAttachment_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  answerId    String        @db.Uuid
