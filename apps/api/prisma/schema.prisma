  failureCode           String?       @db.VarChar(100)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  workspace             Workspace     @relation("Payment_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  orderId               String?       @db.Uuid
  order                 Order?        @relation("Payment_order", fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Restrict)
