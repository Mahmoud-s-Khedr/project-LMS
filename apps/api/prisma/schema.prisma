  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  workspace      Workspace    @relation("Refund_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  paymentId      String       @db.Uuid
  payment        Payment      @relation("Refund_payment", fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: Restrict)
  requestedById  String       @db.Uuid
  requestedBy    User         @relation("Refund_requestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  refundItems    RefundItem[] @relation("RefundItem_refund")

  @@unique([workspaceId, id])
  @@index([workspaceId, paymentId])
  @@index([requestedById])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, status, completedAt])
}

model RefundItem {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  amount       Int
  revokeAccess Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  workspace    Workspace @relation("RefundItem_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  refundId     String    @db.Uuid
  refund       Refund    @relation("RefundItem_refund", fields: [workspaceId, refundId], references: [workspaceId, id], onDelete: Restrict)
  orderItemId  String    @db.Uuid
  orderItem    OrderItem @relation("RefundItem_orderItem", fields: [workspaceId, orderItemId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([refundId, orderItemId])
  @@index([workspaceId, refundId])
  @@index([workspaceId, orderItemId])
}

/// Verified inbox; workspace resolved from trusted local Stripe ID mappings, never client metadata alone.
model StripeWebhook {
  id              String        @id @default(uuid()) @db.Uuid
  stripeEventId   String        @unique @db.VarChar(255)
  type            String        @db.VarChar(160)
  stripeCreatedAt DateTime      @db.Timestamptz(3)
  apiVersion      String?       @db.VarChar(64)
  livemode        Boolean
  payload         Json
  status          WebhookStatus @default(RECEIVED)
  attempts        Int           @default(0)
  processedAt     DateTime?     @db.Timestamptz(3)
  lastError       String?
  lockedUntil     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

model CertificateTemplate {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @db.Uuid
  name              String        @db.VarChar(160)
  version           Int           @default(1)
  layout            Json
  issuerName        String        @db.VarChar(240)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?     @db.Timestamptz(3)
  workspace         Workspace     @relation("CertificateTemplate_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId          String        @db.Uuid
  course            Course        @relation("CertificateTemplate_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  backgroundAssetId String?       @db.Uuid
  background        Asset?        @relation("CertificateTemplate_background", fields: [workspaceId, backgroundAssetId], references: [workspaceId, id], onDelete: Restrict)
  certificates      Certificate[] @relation("Certificate_template")

  @@unique([workspaceId, id])
  @@unique([courseId, version])
  @@index([workspaceId, courseId])
  @@index([workspaceId, backgroundAssetId])
}

model Certificate {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @db.Uuid
  verificationCode  String              @unique @db.VarChar(80)
  status            CertificateStatus   @default(VALID)
  recipientSnapshot Json
  courseSnapshot    Json
  templateSnapshot  Json
  issuedAt          DateTime            @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime?           @db.Timestamptz(3)
  revocationReason  String?             @db.VarChar(1000)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  workspace         Workspace           @relation("Certificate_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  enrollmentId      String              @db.Uuid
  enrollment        Enrollment          @relation("Certificate_enrollment", fields: [workspaceId, enrollmentId], references: [workspaceId, id], onDelete: Restrict)
  templateId        String              @db.Uuid
  template          CertificateTemplate @relation("Certificate_template", fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: Restrict)
  documentAssetId   String?             @db.Uuid
  document          Asset?              @relation("Certificate_document", fields: [workspaceId, documentAssetId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([enrollmentId])
  @@unique([workspaceId, enrollmentId])
  @@index([workspaceId, enrollmentId])
  @@index([workspaceId, templateId])
  @@index([workspaceId, documentAssetId])
  @@index([workspaceId, issuedAt])
}

model Notification {
  id                    String                 @id @default(uuid()) @db.Uuid
  workspaceId           String?                @db.Uuid
  type                  String                 @db.VarChar(100)
  title                 String                 @db.VarChar(240)
  body                  String
  data                  Json                   @default("{}")
  dedupeKey             String                 @db.VarChar(255)
  readAt                DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?              @db.Timestamptz(3)
  workspace             Workspace?             @relation("Notification_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  userId                String                 @db.Uuid
  user                  User                   @relation("Notification_user", fields: [userId], references: [id], onDelete: Restrict)
  notificationDeliverys NotificationDelivery[] @relation("NotificationDelivery_notification")

  @@unique([workspaceId, id])
  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt, id])
}

model NotificationPreference {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String?             @db.Uuid
  type        String              @db.VarChar(100)
  channel     NotificationChannel
  enabled     Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  workspace   Workspace?          @relation("NotificationPreference_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  userId      String              @db.Uuid
  user        User                @relation("NotificationPreference_user", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId, type, channel])
  @@index([userId])
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String?             @db.Uuid
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  recipient         String              @db.VarChar(254)
  providerMessageId String?             @db.VarChar(255)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @db.Timestamptz(3)
  sentAt            DateTime?           @db.Timestamptz(3)
  lastError         String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  workspace         Workspace?          @relation("NotificationDelivery_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  notificationId    String              @db.Uuid
  notification      Notification        @relation("NotificationDelivery_notification", fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([notificationId, channel])
  @@index([workspaceId, notificationId])
  @@index([status, nextAttemptAt])
}

/// Append only, schema-validated, PII-minimal. Client telemetry cannot award grades or certificates.
model ActivityEvent {
  id           String      @id @default(uuid()) @db.Uuid
  workspaceId  String      @db.Uuid
  eventId      String      @db.Uuid
  type         String      @db.VarChar(100)
  occurredAt   DateTime    @db.Timestamptz(3)
  receivedAt   DateTime    @default(now()) @db.Timestamptz(3)
  properties   Json        @default("{}")
  sessionKey   String?     @db.VarChar(100)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  workspace    Workspace   @relation("ActivityEvent_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  userId       String?     @db.Uuid
  user         User?       @relation("ActivityEvent_user", fields: [userId], references: [id], onDelete: Restrict)
  courseId     String?     @db.Uuid
  course       Course?     @relation("ActivityEvent_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  lessonId     String?     @db.Uuid
  lesson       Lesson?     @relation("ActivityEvent_lesson", fields: [workspaceId, lessonId], references: [workspaceId, id], onDelete: Restrict)
  enrollmentId String?     @db.Uuid
  enrollment   Enrollment? @relation("ActivityEvent_enrollment", fields: [workspaceId, enrollmentId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, eventId])
  @@index([userId])
  @@index([workspaceId, lessonId])
  @@index([workspaceId, enrollmentId])
  @@index([workspaceId, courseId, occurredAt, id])
  @@index([workspaceId, userId, occurredAt])
  @@index([userId, receivedAt])
  @@index([userId, occurredAt])
}

model DailyCourseMetric {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @db.Uuid
  day                   DateTime  @db.Date
  newEnrollments        Int       @default(0)
  activeLearners        Int       @default(0)
  completions           Int       @default(0)
  learningSeconds       BigInt    @default(0)
  assessmentSubmissions Int       @default(0)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  workspace             Workspace @relation("DailyCourseMetric_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId              String    @db.Uuid
  course                Course    @relation("DailyCourseMetric_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([courseId, day])
  @@index([workspaceId, courseId])
}

model ReportExport {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @db.Uuid
  kind          String       @db.VarChar(100)
  parameters    Json
  status        ExportStatus @default(PENDING)
  startedAt     DateTime?    @db.Timestamptz(3)
  completedAt   DateTime?    @db.Timestamptz(3)
  expiresAt     DateTime     @db.Timestamptz(3)
  lockedUntil   DateTime?    @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  workspace     Workspace    @relation("ReportExport_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  requestedById String       @db.Uuid
  requestedBy   User         @relation("ReportExport_requestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  assetId       String?      @db.Uuid
  asset         Asset?       @relation("ReportExport_asset", fields: [workspaceId, assetId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([requestedById])
  @@index([workspaceId, assetId])
  @@index([workspaceId, requestedById, createdAt])
  @@index([status, expiresAt])
  @@index([status, lockedUntil, createdAt])
}

/// Domain transaction + event insert are atomic. Publish to BullMQ at least once; consumers dedupe.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String?      @db.Uuid
  type          String       @db.VarChar(100)
  schemaVersion Int          @default(1)
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(128)
  payload       Json
  status        OutboxStatus @default(PENDING)
  sequence      BigInt       @default(autoincrement())
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  attempts      Int          @default(0)
  lockedUntil   DateTime?    @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  workspace     Workspace?   @relation("OutboxEvent_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)

  receipts EventReceipt[] @relation("EventReceipt_event")

  @@unique([workspaceId, id])
  @@unique([sequence])
  @@index([status, availableAt, sequence])
}

model EventReceipt {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @db.Uuid
  eventId     String     @db.Uuid
  consumer    String     @db.VarChar(100)
  processedAt DateTime   @default(now()) @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  workspace   Workspace? @relation("EventReceipt_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)

  event OutboxEvent @relation("EventReceipt_event", fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([eventId, consumer])
}

/// Append only; nullable workspace permits platform/security audits. No secrets or answer keys in changes.
model AuditLog {
  id           String     @id @default(uuid()) @db.Uuid
  action       String     @db.VarChar(120)
  resourceType String     @db.VarChar(100)
  resourceId   String     @db.VarChar(128)
  requestId    String     @db.VarChar(100)
  changes      Json       @default("{}")
  ipHash       String?    @db.Char(64)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  workspaceId  String?    @db.Uuid
  workspace    Workspace? @relation("AuditLog_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  actorId      String?    @db.Uuid
  actor        User?      @relation("AuditLog_actor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([workspaceId, createdAt, id])
  @@index([resourceType, resourceId, createdAt])
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @db.Uuid
  key            String            @db.VarChar(128)
  route          String            @db.VarChar(240)
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  response       Json?
  expiresAt      DateTime          @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  workspace      Workspace         @relation("IdempotencyRecord_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  userId         String            @db.Uuid
  user           User              @relation("IdempotencyRecord_user", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId, route, key])
  @@index([userId])
  @@index([expiresAt])
}
