model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @db.Uuid
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String             @unique @db.VarChar(255)
