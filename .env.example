NODE_ENV=development
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:55432/lms?schema=public
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_dev_password
POSTGRES_DB=lms
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=lms_minio
S3_SECRET_ACCESS_KEY=lms_minio_dev_password
S3_PRIVATE_BUCKET=lms-private
S3_PUBLIC_BUCKET=lms-public
S3_FORCE_PATH_STYLE=true
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_FROM="LMS <noreply@lms.local>"
JWT_ACCESS_SECRET=replace-this-development-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-development-refresh-secret-at-least-32-characters
TENANCY_MAIL_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
TENANCY_MAIL_KEY_ID=v1
AUDIT_IP_HASH_SECRET=replace-this-development-audit-ip-hash-secret-at-least-32-chars
LOG_LEVEL=info

REFRESH_REUSE_GRACE_SECONDS=30

NEXT_PUBLIC_SITE_NAME=LMS

# INT-2 domain configuration: empty Stripe keys disable payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_CURRENCIES=usd,eur,gbp,egp
CONTENT_HOST_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CONTENT_EMBED_ORIGINS=https://www.youtube-nocookie.com,https://player.vimeo.com,https://www.h5p.com
CONTENT_WORKSPACE_QUOTA_BYTES=107374182400
API_PUBLIC_ORIGIN=http://localhost:4100
# Keep clamav by default; explicitly opt into development-bypass for local upload tests.
MEDIA_SCANNER_MODE=clamav
NEXT_PUBLIC_SITE_NAME=LMS

# Server-side web access to the API (no /api/v1 suffix)
API_INTERNAL_ORIGIN=http://localhost:4100
# Sandboxed Chrome executable used by certificate workers
CERTIFICATE_CHROMIUM_PATH=/usr/bin/google-chrome
