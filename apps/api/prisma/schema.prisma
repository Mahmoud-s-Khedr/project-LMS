  entitlementSnapshot Json
  unitAmount          Int
  discountAmount      Int               @default(0)
  taxAmount           Int               @default(0)
  totalAmount         Int
  accessDurationDays  Int?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  workspace           Workspace         @relation("OrderItem_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  orderId             String            @db.Uuid
  order               Order             @relation("OrderItem_order", fields: [workspaceId, orderId], references: [workspaceId, id], onDelete: Restrict)
  productId           String            @db.Uuid
  product             Product           @relation("OrderItem_product", fields: [workspaceId, productId], references: [workspaceId, id], onDelete: Restrict)
