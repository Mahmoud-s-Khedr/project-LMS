  attemptAnswers      AttemptAnswer[]   @relation("AttemptAnswer_attempt")
  gradeEvents         GradeEvent[]      @relation("GradeEvent_attempt")

  @@unique([workspaceId, id])
  @@unique([assessmentId, enrollmentId, number])
  @@index([workspaceId, courseId, assessmentId])
  @@index([workspaceId, assessmentId, assessmentVersionId])
  @@index([workspaceId, courseId, enrollmentId])
  @@index([workspaceId, status, deadlineAt])
}

/// Snapshot contains student-visible prompt/options only. Answers remain in privileged version FK.
model AttemptQuestion {
  id                String            @id @default(uuid()) @db.Uuid
  workspaceId       String            @db.Uuid
  position          Int
  points            Decimal           @db.Decimal(10, 3)
  isRequired        Boolean           @default(true)
  questionSnapshot  Json
  optionOrder       Json              @default("[]")
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  workspace         Workspace         @relation("AttemptQuestion_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  attemptId         String            @db.Uuid
  attempt           AssessmentAttempt @relation("AttemptQuestion_attempt", fields: [workspaceId, attemptId], references: [workspaceId, id], onDelete: Restrict)
  questionVersionId String            @db.Uuid
  questionVersion   QuestionVersion   @relation("AttemptQuestion_questionVersion", fields: [workspaceId, questionVersionId], references: [workspaceId, id], onDelete: Restrict)
  answer            AttemptAnswer?    @relation("AttemptAnswer_attemptQuestion")

  @@unique([workspaceId, id])
  @@unique([workspaceId, attemptId, id])
  @@unique([attemptId, position])
  @@unique([attemptId, questionVersionId])
  @@index([workspaceId, questionVersionId])
}

model AttemptAnswer {
  id                    String             @id @default(uuid()) @db.Uuid
  workspaceId           String             @db.Uuid
  response              Json               @default("{}")
  awardedPoints         Decimal?           @db.Decimal(10, 3)
  isCorrect             Boolean?
  requiresManualGrading Boolean            @default(false)
  feedback              String?
  savedAt               DateTime           @default(now()) @db.Timestamptz(3)
  version               Int                @default(1)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  workspace             Workspace          @relation("AttemptAnswer_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  attemptId             String             @db.Uuid
  attempt               AssessmentAttempt  @relation("AttemptAnswer_attempt", fields: [workspaceId, attemptId], references: [workspaceId, id], onDelete: Restrict)
  attemptQuestionId     String             @db.Uuid
  attemptQuestion       AttemptQuestion    @relation("AttemptAnswer_attemptQuestion", fields: [workspaceId, attemptId, attemptQuestionId], references: [workspaceId, attemptId, id], onDelete: Restrict)
