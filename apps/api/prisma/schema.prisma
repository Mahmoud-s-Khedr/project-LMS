  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([userId])
}

model Order {
  id                      String            @id @default(uuid()) @db.Uuid
  workspaceId             String            @db.Uuid
  number                  String            @unique @db.VarChar(40)
  status                  OrderStatus       @default(PENDING)
  currency                String            @db.Char(3)
  subtotal                Int
  discountTotal           Int               @default(0)
  taxTotal                Int               @default(0)
  grandTotal              Int
  billingSnapshot         Json              @default("{}")
  stripeCheckoutSessionId String?           @unique @db.VarChar(255)
  paidAt                  DateTime?         @db.Timestamptz(3)
  expiresAt               DateTime?         @db.Timestamptz(3)
  createdAt               DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(3)
  workspace               Workspace         @relation("Order_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  userId                  String            @db.Uuid
  user                    User              @relation("Order_user", fields: [userId], references: [id], onDelete: Restrict)
  couponId                String?           @db.Uuid
  coupon                  Coupon?           @relation("Order_coupon", fields: [workspaceId, couponId], references: [workspaceId, id], onDelete: Restrict)
  orderItems              OrderItem[]       @relation("OrderItem_order")
  couponRedemption        CouponRedemption? @relation("CouponRedemption_order")
  payments                Payment[]         @relation("Payment_order")
  subscriptions           Subscription[]    @relation("Subscription_initialOrder")

  @@unique([workspaceId, id])
  @@index([workspaceId, couponId])
  @@index([workspaceId, status, createdAt, id])
  @@index([userId, createdAt, id])
}

model OrderItem {
  id                  String            @id @default(uuid()) @db.Uuid
  workspaceId         String            @db.Uuid
  quantity            Int               @default(1)
