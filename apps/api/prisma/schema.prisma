  orderItemCourses    OrderItemCourse[] @relation("OrderItemCourse_orderItem")
  refundItems         RefundItem[]      @relation("RefundItem_orderItem")

  @@unique([workspaceId, id])
  @@index([workspaceId, orderId])
  @@index([workspaceId, productId])
  @@index([workspaceId, priceId])
}

/// Frozen entitlement rows, also used for pending cohort seat reservations; bundles may select multiple cohorts.
model OrderItemCourse {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @db.Uuid
  accessDurationDays    Int?
  releasePolicySnapshot Json      @default("{}")
