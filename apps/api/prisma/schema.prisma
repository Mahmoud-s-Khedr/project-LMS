  @@unique([workspaceId, id])
  @@unique([answerId, assetId])
  @@index([workspaceId, answerId])
  @@index([workspaceId, assetId])
}

model GradeEvent {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @db.Uuid
  previousPoints Decimal?          @db.Decimal(12, 3)
  awardedPoints  Decimal           @db.Decimal(12, 3)
  rubricScores   Json?
  feedback       String?
  reason         String            @db.VarChar(1000)
  isAutomatic    Boolean           @default(false)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
