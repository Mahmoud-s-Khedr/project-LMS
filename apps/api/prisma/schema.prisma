  deadlineAt          DateTime?         @db.Timestamptz(3)
  submittedAt         DateTime?         @db.Timestamptz(3)
  gradedAt            DateTime?         @db.Timestamptz(3)
  isLate              Boolean           @default(false)
  totalPoints         Decimal           @db.Decimal(12, 3)
  awardedPoints       Decimal?          @db.Decimal(12, 3)
  percent             Decimal?          @db.Decimal(5, 2)
  passed              Boolean?
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  workspace           Workspace         @relation("AssessmentAttempt_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId            String            @db.Uuid
  course              Course            @relation("AssessmentAttempt_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  assessmentId        String            @db.Uuid
  assessment          Assessment        @relation("AssessmentAttempt_assessment", fields: [workspaceId, courseId, assessmentId], references: [workspaceId, courseId, id], onDelete: Restrict)
  assessmentVersionId String            @db.Uuid
  assessmentVersion   AssessmentVersion @relation("AssessmentAttempt_assessmentVersion", fields: [workspaceId, assessmentId, assessmentVersionId], references: [workspaceId, assessmentId, id], onDelete: Restrict)
  enrollmentId        String            @db.Uuid
  enrollment          Enrollment        @relation("AssessmentAttempt_enrollment", fields: [workspaceId, courseId, enrollmentId], references: [workspaceId, courseId, id], onDelete: Restrict)
