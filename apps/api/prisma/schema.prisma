// LMS canonical relational model. See docs/ARCHITECTURE.md for mandatory SQL CHECKs,
// tenant invariants, state machines, JSON payload schemas and retention policies.
// Nullable workspace scope is reserved for global identity/security events, notifications
// and their operational records; all course, learner and commerce aggregates are tenant-bound.
// Prisma 7: DATABASE_URL belongs in apps/api/prisma.config.ts (scaffolding owner).
// Use @prisma/adapter-pg with @prisma/client; no app code is generated by this file.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  TEACHING_ASSISTANT
  STUDENT
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum WorkspaceKind {
  PERSONAL
  ACADEMY
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum DeliveryMode {
  SELF_PACED
  COHORT
}

enum StaffRole {
  INSTRUCTOR
  TEACHING_ASSISTANT
}

enum LessonType {
  VIDEO
  DOCUMENT
  TEXT
  INTERACTIVE
  QUIZ
  ASSIGNMENT
  EXAM
  LIVE_SESSION
}

enum ReleaseType {
  IMMEDIATE
  ABSOLUTE
  ENROLLMENT_OFFSET
  COHORT_OFFSET
}

enum CompletionRule {
  VIEW
  ACKNOWLEDGE
  WATCH_PERCENT
  ASSESSMENT_PASS
  ATTENDANCE
}

enum AssetStatus {
  PENDING_UPLOAD
  SCANNING
  READY
  REJECTED
  DELETED
}

enum AssetVisibility {
  PRIVATE
  PUBLIC
}

enum AssessmentKind {
  QUIZ
  ASSIGNMENT
  EXAM
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
  ESSAY
  FILE_UPLOAD
  MATCHING
  ORDERING
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum GradePolicy {
  HIGHEST
  LATEST
  FIRST
}

enum FeedbackPolicy {
  IMMEDIATE
  AFTER_DUE
  AFTER_GRADING
  NEVER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  GRADED
  VOID
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum GrantSource {
  FREE
  MANUAL
  ORDER_ITEM
  SUBSCRIPTION
}

enum ProductType {
  COURSE
  BUNDLE
  SUBSCRIPTION_PLAN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum CouponKind {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  PAUSED
  CANCELED
  EXPIRED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SUPPRESSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELED
}

enum AttendanceStatus {
  REGISTERED
  ATTENDED
  ABSENT
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Global identity. platformRole permits only SUPER_ADMIN or STUDENT; tenant roles live in memberships.
model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  email                   String                    @unique @db.VarChar(254)
  avatarKey               String?                   @db.VarChar(512)
  passwordHash            String?                   @db.VarChar(255)
  name                    String                    @db.VarChar(160)
  platformRole            Role                      @default(STUDENT)
  status                  UserStatus                @default(ACTIVE)
  emailVerifiedAt         DateTime?                 @db.Timestamptz(3)
  passwordChangedAt       DateTime?                 @db.Timestamptz(3)
  locale                  String                    @default("en") @db.VarChar(20)
  timezone                String                    @default("UTC") @db.VarChar(64)
  lastLoginAt             DateTime?                 @db.Timestamptz(3)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt               DateTime?                 @db.Timestamptz(3)
  ownedWorkspaces         Workspace[]               @relation("Workspace_owner")
  memberships             WorkspaceMember[]         @relation("WorkspaceMember_user")
  sentInvitations         WorkspaceInvitation[]     @relation("WorkspaceInvitation_invitedBy")
  refreshSessions         RefreshSession[]          @relation("RefreshSession_user")
  authTokens              AuthToken[]               @relation("AuthToken_user")
  createdCourses          Course[]                  @relation("Course_createdBy")
  uploadedAssets          Asset[]                   @relation("Asset_uploadedBy")
  enrollments             Enrollment[]              @relation("Enrollment_user")
  grantedAccess           EnrollmentGrant[]         @relation("EnrollmentGrant_grantedBy")
  createdQuestionBanks    QuestionBank[]            @relation("QuestionBank_createdBy")
  createdQuestions        Question[]                @relation("Question_createdBy")
  grantedAccommodations   AssessmentAccommodation[] @relation("AssessmentAccommodation_grantedBy")
  gradingEvents           GradeEvent[]              @relation("GradeEvent_gradedBy")
  billingCustomers        BillingCustomer[]         @relation("BillingCustomer_user")
  orders                  Order[]                   @relation("Order_user")
  couponRedemptions       CouponRedemption[]        @relation("CouponRedemption_user")
  subscriptions           Subscription[]            @relation("Subscription_user")
  requestedRefunds        Refund[]                  @relation("Refund_requestedBy")
  notifications           Notification[]            @relation("Notification_user")
  notificationPreferences NotificationPreference[]  @relation("NotificationPreference_user")
  activityEvents          ActivityEvent[]           @relation("ActivityEvent_user")
  requestedExports        ReportExport[]            @relation("ReportExport_requestedBy")
  auditLogs               AuditLog[]                @relation("AuditLog_actor")
  idempotencyRecords      IdempotencyRecord[]       @relation("IdempotencyRecord_user")
}

/// A personal business or optional academy; never a school hierarchy.
model Workspace {
  id                       String                    @id @default(uuid()) @db.Uuid
  kind                     WorkspaceKind
  status                   WorkspaceStatus           @default(ACTIVE)
  suspendedAt              DateTime?                 @db.Timestamptz(3)
  suspensionReason         String?                   @db.VarChar(1000)
  slug                     String                    @unique @db.VarChar(100)
  name                     String                    @db.VarChar(160)
  description              String?
  logoUrl                  String?
  defaultCurrency          String                    @default("usd") @db.Char(3)
  timezone                 String                    @default("UTC") @db.VarChar(64)
  settings                 Json                      @default("{}")
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?                 @db.Timestamptz(3)
  ownerId                  String                    @db.Uuid
  owner                    User                      @relation("Workspace_owner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                  WorkspaceMember[]         @relation("WorkspaceMember_workspace")
  invitations              WorkspaceInvitation[]     @relation("WorkspaceInvitation_workspace")
  courses                  Course[]                  @relation("Course_workspace")
  staffAssignments         CourseStaff[]             @relation("CourseStaff_workspace")
  categories               Category[]                @relation("Category_workspace")
  categoryLinks            CourseCategory[]          @relation("CourseCategory_workspace")
  coursePrerequisites      CoursePrerequisite[]      @relation("CoursePrerequisite_workspace")
  sections                 Section[]                 @relation("Section_workspace")
  lessons                  Lesson[]                  @relation("Lesson_workspace")
  lessonPrerequisites      LessonPrerequisite[]      @relation("LessonPrerequisite_workspace")
  assets                   Asset[]                   @relation("Asset_workspace")
  lessonAssets             LessonAsset[]             @relation("LessonAsset_workspace")
  cohorts                  Cohort[]                  @relation("Cohort_workspace")
  cohortLessonReleases     CohortLessonRelease[]     @relation("CohortLessonRelease_workspace")
  liveSessions             LiveSession[]             @relation("LiveSession_workspace")
  enrollments              Enrollment[]              @relation("Enrollment_workspace")
  enrollmentGrants         EnrollmentGrant[]         @relation("EnrollmentGrant_workspace")
  lessonProgress           LessonProgress[]          @relation("LessonProgress_workspace")
  attendance               Attendance[]              @relation("Attendance_workspace")
  questionBanks            QuestionBank[]            @relation("QuestionBank_workspace")
  questions                Question[]                @relation("Question_workspace")
  questionVersions         QuestionVersion[]         @relation("QuestionVersion_workspace")
  questionOptions          QuestionOption[]          @relation("QuestionOption_workspace")
  assessments              Assessment[]              @relation("Assessment_workspace")
  assessmentVersions       AssessmentVersion[]       @relation("AssessmentVersion_workspace")
  assessmentQuestions      AssessmentQuestion[]      @relation("AssessmentQuestion_workspace")
  assessmentPools          AssessmentPool[]          @relation("AssessmentPool_workspace")
  assessmentPoolQuestions  AssessmentPoolQuestion[]  @relation("AssessmentPoolQuestion_workspace")
  assessmentAccommodations AssessmentAccommodation[] @relation("AssessmentAccommodation_workspace")
  assessmentAttempts       AssessmentAttempt[]       @relation("AssessmentAttempt_workspace")
  attemptQuestions         AttemptQuestion[]         @relation("AttemptQuestion_workspace")
  attemptAnswers           AttemptAnswer[]           @relation("AttemptAnswer_workspace")
  answerAttachments        AnswerAttachment[]        @relation("AnswerAttachment_workspace")
  gradeEvents              GradeEvent[]              @relation("GradeEvent_workspace")
  products                 Product[]                 @relation("Product_workspace")
  productCourses           ProductCourse[]           @relation("ProductCourse_workspace")
  prices                   Price[]                   @relation("Price_workspace")
  coupons                  Coupon[]                  @relation("Coupon_workspace")
  couponProducts           CouponProduct[]           @relation("CouponProduct_workspace")
  billingCustomers         BillingCustomer[]         @relation("BillingCustomer_workspace")
  orders                   Order[]                   @relation("Order_workspace")
  orderItems               OrderItem[]               @relation("OrderItem_workspace")
  orderItemCourses         OrderItemCourse[]         @relation("OrderItemCourse_workspace")
  couponRedemptions        CouponRedemption[]        @relation("CouponRedemption_workspace")
  payments                 Payment[]                 @relation("Payment_workspace")
  subscriptions            Subscription[]            @relation("Subscription_workspace")
  refunds                  Refund[]                  @relation("Refund_workspace")
  refundItems              RefundItem[]              @relation("RefundItem_workspace")
  certificateTemplates     CertificateTemplate[]     @relation("CertificateTemplate_workspace")
  certificates             Certificate[]             @relation("Certificate_workspace")
  notifications            Notification[]            @relation("Notification_workspace")
  notificationPreferences  NotificationPreference[]  @relation("NotificationPreference_workspace")
  notificationDeliverys    NotificationDelivery[]    @relation("NotificationDelivery_workspace")
  activityEvents           ActivityEvent[]           @relation("ActivityEvent_workspace")
  dailyMetrics             DailyCourseMetric[]       @relation("DailyCourseMetric_workspace")
  reportExports            ReportExport[]            @relation("ReportExport_workspace")
  outboxEvents             OutboxEvent[]             @relation("OutboxEvent_workspace")
  eventReceipts            EventReceipt[]            @relation("EventReceipt_workspace")
  auditLogs                AuditLog[]                @relation("AuditLog_workspace")
  idempotencyRecords       IdempotencyRecord[]       @relation("IdempotencyRecord_workspace")

  @@index([ownerId])
}

model WorkspaceMember {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @db.Uuid
  role             Role             @default(STUDENT)
  status           MembershipStatus @default(ACTIVE)
  joinedAt         DateTime         @default(now()) @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?        @db.Timestamptz(3)
  workspace        Workspace        @relation("WorkspaceMember_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  userId           String           @db.Uuid
  user             User             @relation("WorkspaceMember_user", fields: [userId], references: [id], onDelete: Restrict)
  staffAssignments CourseStaff[]    @relation("CourseStaff_member")

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([userId, status])
}

model WorkspaceInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  email       String    @db.VarChar(254)
  role        Role
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation("WorkspaceInvitation_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  invitedById String    @db.Uuid
  invitedBy   User      @relation("WorkspaceInvitation_invitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([invitedById])
  @@index([workspaceId, email])
}

/// Each rotation inserts a child. Reuse revokes the family; retain consumed hashes through family expiry.
model RefreshSession {
  id         String          @id @default(uuid()) @db.Uuid
  familyId   String          @db.Uuid
  tokenHash  String          @unique @db.Char(64)
  parentId   String?         @unique @db.Uuid
  expiresAt  DateTime        @db.Timestamptz(3)
  consumedAt DateTime?       @db.Timestamptz(3)
  revokedAt  DateTime?       @db.Timestamptz(3)
  userAgent  String?         @db.VarChar(512)
  ipHash     String?         @db.Char(64)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  userId     String          @db.Uuid
  user       User            @relation("RefreshSession_user", fields: [userId], references: [id], onDelete: Restrict)
  parent     RefreshSession? @relation("RefreshSession_parent", fields: [parentId], references: [id], onDelete: Restrict)
  child      RefreshSession? @relation("RefreshSession_parent")

  @@index([userId])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model AuthToken {
  id         String       @id @default(uuid()) @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @db.Char(64)
  expiresAt  DateTime     @db.Timestamptz(3)
  consumedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  userId     String       @db.Uuid
  user       User         @relation("AuthToken_user", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id                       String                    @id @default(uuid()) @db.Uuid
  workspaceId              String                    @db.Uuid
  slug                     String                    @db.VarChar(140)
  title                    String                    @db.VarChar(240)
  summary                  String                    @db.VarChar(1000)
  description              Json                      @default("{}")
  status                   CourseStatus              @default(DRAFT)
  visibility               Visibility                @default(PUBLIC)
  deliveryMode             DeliveryMode              @default(SELF_PACED)
  language                 String                    @default("en") @db.VarChar(20)
  level                    String?                   @db.VarChar(40)
  isFree                   Boolean                   @default(false)
  estimatedMinutes         Int                       @default(0)
  version                  Int                       @default(1)
  publishedAt              DateTime?                 @db.Timestamptz(3)
  archivedAt               DateTime?                 @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?                 @db.Timestamptz(3)
  workspace                Workspace                 @relation("Course_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  createdById              String                    @db.Uuid
  createdBy                User                      @relation("Course_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  coverId                  String?                   @db.Uuid
  cover                    Asset?                    @relation("Course_cover", fields: [workspaceId, coverId], references: [workspaceId, id], onDelete: Restrict)
  staffAssignments         CourseStaff[]             @relation("CourseStaff_course")
  categoryLinks            CourseCategory[]          @relation("CourseCategory_course")
  prerequisites            CoursePrerequisite[]      @relation("CoursePrerequisite_course")
  requiredByCourses        CoursePrerequisite[]      @relation("CoursePrerequisite_requiredCourse")
  sections                 Section[]                 @relation("Section_course")
  lessons                  Lesson[]                  @relation("Lesson_course")
  lessonPrerequisites      LessonPrerequisite[]      @relation("LessonPrerequisite_course")
  cohorts                  Cohort[]                  @relation("Cohort_course")
  cohortLessonReleases     CohortLessonRelease[]     @relation("CohortLessonRelease_course")
  liveSessions             LiveSession[]             @relation("LiveSession_course")
  enrollments              Enrollment[]              @relation("Enrollment_course")
  lessonProgress           LessonProgress[]          @relation("LessonProgress_course")
  attendance               Attendance[]              @relation("Attendance_course")
  assessments              Assessment[]              @relation("Assessment_course")
  assessmentAccommodations AssessmentAccommodation[] @relation("AssessmentAccommodation_course")
  assessmentAttempts       AssessmentAttempt[]       @relation("AssessmentAttempt_course")
  productCourses           ProductCourse[]           @relation("ProductCourse_course")
  orderItemCourses         OrderItemCourse[]         @relation("OrderItemCourse_course")
  certificateTemplates     CertificateTemplate[]     @relation("CertificateTemplate_course")
  activityEvents           ActivityEvent[]           @relation("ActivityEvent_course")
  dailyMetrics             DailyCourseMetric[]       @relation("DailyCourseMetric_course")

  @@unique([workspaceId, id])
  @@unique([workspaceId, slug])
  @@index([createdById])
  @@index([workspaceId, coverId])
  @@index([workspaceId, status, visibility, publishedAt, id])
}

model CourseStaff {
  id                String          @id @default(uuid()) @db.Uuid
  workspaceId       String          @db.Uuid
  role              StaffRole
  canEditContent    Boolean         @default(false)
  canGrade          Boolean         @default(true)
  canManageLearners Boolean         @default(false)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  workspace         Workspace       @relation("CourseStaff_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId          String          @db.Uuid
  course            Course          @relation("CourseStaff_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  userId            String          @db.Uuid
  member            WorkspaceMember @relation("CourseStaff_member", fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([courseId, userId])
  @@index([workspaceId, courseId])
  @@index([workspaceId, userId])
}

model Category {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @db.Uuid
  slug          String           @db.VarChar(100)
  name          String           @db.VarChar(120)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?        @db.Timestamptz(3)
  workspace     Workspace        @relation("Category_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  categoryLinks CourseCategory[] @relation("CourseCategory_category")

  @@unique([workspaceId, id])
  @@unique([workspaceId, slug])
}

model CourseCategory {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  workspace   Workspace @relation("CourseCategory_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId    String    @db.Uuid
  course      Course    @relation("CourseCategory_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  categoryId  String    @db.Uuid
  category    Category  @relation("CourseCategory_category", fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([courseId, categoryId])
  @@index([workspaceId, courseId])
  @@index([workspaceId, categoryId])
}

model CoursePrerequisite {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  minimumPercent   Decimal   @default(100) @db.Decimal(5, 2)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  workspace        Workspace @relation("CoursePrerequisite_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId         String    @db.Uuid
  course           Course    @relation("CoursePrerequisite_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  requiredCourseId String    @db.Uuid
  requiredCourse   Course    @relation("CoursePrerequisite_requiredCourse", fields: [workspaceId, requiredCourseId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([courseId, requiredCourseId])
  @@index([workspaceId, courseId])
  @@index([workspaceId, requiredCourseId])
}

model Section {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  title       String    @db.VarChar(240)
  position    Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  workspace   Workspace @relation("Section_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId    String    @db.Uuid
  course      Course    @relation("Section_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  lessons     Lesson[]  @relation("Lesson_section")

  @@unique([workspaceId, id])
  @@unique([courseId, position])
  @@unique([workspaceId, courseId, id])
}

model Lesson {
  id                   String                @id @default(uuid()) @db.Uuid
  workspaceId          String                @db.Uuid
  title                String                @db.VarChar(240)
  type                 LessonType
  position             Int
  body                 Json                  @default("{}")
  embedUrl             String?
  isRequired           Boolean               @default(true)
  isPreview            Boolean               @default(false)
  isPublished          Boolean               @default(false)
  estimatedMinutes     Int                   @default(0)
  completionRule       CompletionRule        @default(ACKNOWLEDGE)
  requiredWatchPercent Int                   @default(90)
  releaseType          ReleaseType           @default(IMMEDIATE)
  releaseAt            DateTime?             @db.Timestamptz(3)
  releaseOffsetDays    Int?
  availableUntil       DateTime?             @db.Timestamptz(3)
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?             @db.Timestamptz(3)
  workspace            Workspace             @relation("Lesson_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId             String                @db.Uuid
  course               Course                @relation("Lesson_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  sectionId            String                @db.Uuid
  section              Section               @relation("Lesson_section", fields: [workspaceId, courseId, sectionId], references: [workspaceId, courseId, id], onDelete: Restrict)
  prerequisites        LessonPrerequisite[]  @relation("LessonPrerequisite_lesson")
  requiredByLessons    LessonPrerequisite[]  @relation("LessonPrerequisite_requiredLesson")
  lessonAssets         LessonAsset[]         @relation("LessonAsset_lesson")
  cohortLessonReleases CohortLessonRelease[] @relation("CohortLessonRelease_lesson")
  liveSessions         LiveSession[]         @relation("LiveSession_lesson")
  lessonProgress       LessonProgress[]      @relation("LessonProgress_lesson")
  assessment           Assessment?           @relation("Assessment_lesson")
  activityEvents       ActivityEvent[]       @relation("ActivityEvent_lesson")

  @@unique([workspaceId, id])
  @@unique([sectionId, position])
  @@unique([workspaceId, courseId, id])
  @@index([workspaceId, courseId, sectionId])
}

