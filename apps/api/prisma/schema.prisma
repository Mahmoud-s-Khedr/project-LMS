  enrollmentGrants     EnrollmentGrant[]  @relation("EnrollmentGrant_subscription")
  payments             Payment[]          @relation("Payment_subscription")

  @@unique([workspaceId, id])
  @@index([userId])
  @@index([workspaceId, productId])
  @@index([workspaceId, priceId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, initialOrderId])
  @@index([workspaceId, userId, status])
  @@index([workspaceId, currentPeriodEnd])
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
