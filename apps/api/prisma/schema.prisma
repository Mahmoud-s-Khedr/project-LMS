/// One learner/course record; effective access is computed from active grants, never this row alone.
model Enrollment {
  id                       String                    @id @default(uuid()) @db.Uuid
  workspaceId              String                    @db.Uuid
  status                   EnrollmentStatus          @default(ACTIVE)
  enrolledAt               DateTime                  @default(now()) @db.Timestamptz(3)
  startedAt                DateTime?                 @db.Timestamptz(3)
  completedAt              DateTime?                 @db.Timestamptz(3)
  lastActivityAt           DateTime?                 @db.Timestamptz(3)
  completionPercent        Decimal                   @default(0) @db.Decimal(5, 2)
  policySnapshot           Json                      @default("{}")
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(3)
  workspace                Workspace                 @relation("Enrollment_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  courseId                 String                    @db.Uuid
  course                   Course                    @relation("Enrollment_course", fields: [workspaceId, courseId], references: [workspaceId, id], onDelete: Restrict)
  userId                   String                    @db.Uuid
  user                     User                      @relation("Enrollment_user", fields: [userId], references: [id], onDelete: Restrict)
  cohortId                 String?                   @db.Uuid
  cohort                   Cohort?                   @relation("Enrollment_cohort", fields: [workspaceId, courseId, cohortId], references: [workspaceId, courseId, id], onDelete: Restrict)
