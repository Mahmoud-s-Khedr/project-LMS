  activityEvents           ActivityEvent[]           @relation("ActivityEvent_enrollment")

  @@unique([workspaceId, id])
  @@unique([courseId, userId])
  @@unique([workspaceId, courseId, id])
  @@index([workspaceId, courseId, cohortId])
  @@index([userId, status, lastActivityAt])
  @@index([workspaceId, courseId, createdAt, id])
}

/// Unique sourceKey makes fulfillment idempotent; exactly one commerce source, or manual/free, is required.
model EnrollmentGrant {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @db.Uuid
  source         GrantSource
  startsAt       DateTime      @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime?     @db.Timestamptz(3)
  revokedAt      DateTime?     @db.Timestamptz(3)
  reason         String?       @db.VarChar(1000)
  sourceKey      String        @db.VarChar(255)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  workspace      Workspace     @relation("EnrollmentGrant_workspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  enrollmentId   String        @db.Uuid
  enrollment     Enrollment    @relation("EnrollmentGrant_enrollment", fields: [workspaceId, enrollmentId], references: [workspaceId, id], onDelete: Restrict)
  orderItemId    String?       @db.Uuid
  orderItem      OrderItem?    @relation("EnrollmentGrant_orderItem", fields: [workspaceId, orderItemId], references: [workspaceId, id], onDelete: Restrict)
  subscriptionId String?       @db.Uuid
  subscription   Subscription? @relation("EnrollmentGrant_subscription", fields: [workspaceId, subscriptionId], references: [workspaceId, id], onDelete: Restrict)
  grantedById    String?       @db.Uuid
  grantedBy      User?         @relation("EnrollmentGrant_grantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([enrollmentId, sourceKey])
  @@index([workspaceId, enrollmentId])
  @@index([workspaceId, orderItemId])
  @@index([workspaceId, subscriptionId])
  @@index([grantedById])
  @@index([workspaceId, expiresAt, revokedAt])
}

